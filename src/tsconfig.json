{
  "compilerOptions": {
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*":["./*"],
      "geoConfigExporter": ["./geoConfigExporter"],
      "*": ["./*"]
    },
    "strictNullChecks": false,
    "target": "ES2015",
    "lib": ["dom", "dom.iterable", "es2015", "es2016", "es2017"],
    "types": ["node"],
    "moduleResolution": "bundler"
  },
}