# Tile responses are deterministic for a given request URI, so they are stored
# here and served without reaching the tiler. keys_zone holds metadata only,
# max_size caps the payload on disk, and nginx evicts least recently used
# entries once that cap is reached.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:10m
                 max_size=1g inactive=7d use_temp_path=off;

# Point queries carry one URI per coordinate, an unbounded set of keys with no
# reuse, so only tiles are cached. Both the lookup and the store are skipped
# when this is non-zero.
map $uri $skip_tile_cache {
    default        1;
    ~^/cog/tiles/  0;
}

# Response header allowlist for proxied tiler responses, defined once so the
# locations below cannot drift apart. Anything the upstream injects (cookies,
# server identity, CORS overrides) is dropped. Called from header_filter_by_lua_block,
# the only phase where ngx.resp.get_headers is available.
init_by_lua_block {
    local keep = {
        ["content-type"]      = true,
        ["content-length"]    = true,
        ["content-encoding"]  = true,
        ["content-range"]     = true,
        ["transfer-encoding"] = true,
        ["accept-ranges"]     = true,
        ["cache-control"]     = true,
        ["etag"]              = true,
        ["last-modified"]     = true,
        ["expires"]           = true,
    }

    function sanitize_upstream_headers()
        for k in pairs(ngx.resp.get_headers()) do
            if not keep[k:lower()] then
                ngx.header[k] = nil
            end
        end
        ngx.header["X-Content-Type-Options"] = "nosniff"
    end
}

server {
    listen 5173;

    # Planetcantile tile server — sanitize all upstream responses before they reach the client.
    # Any header the upstream injects (cookies, server info, CORS overrides) is stripped here.
    # Upstream errors are intercepted and returned as a clean 502 JSON response.

    # Point queries go to an instance that renders no tiles. Tile rendering is
    # CPU bound and holds each worker process's GIL, so a point query sharing an
    # instance with it waits for that work to finish.
    location /cog/point {
        proxy_pass         http://planetcantile-point:8000/cog/point;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;

        proxy_connect_timeout    5s;
        proxy_read_timeout       30s;
        proxy_max_temp_file_size 10m;

        proxy_intercept_errors on;
        error_page 404 = @tile_no_data;
        error_page 400 401 403 500 502 503 504 = @tile_error;

        header_filter_by_lua_block { sanitize_upstream_headers() }
    }

    location /cog/ {
        proxy_pass         http://planetcantile:8000/cog/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;

        proxy_connect_timeout    5s;
        proxy_read_timeout       30s;
        proxy_max_temp_file_size 10m;

        proxy_cache        tiles;
        proxy_cache_bypass $skip_tile_cache;
        proxy_no_cache     $skip_tile_cache;
        proxy_cache_key    $request_uri;
        # Held for a day rather than indefinitely so a regenerated COG appears
        # without a manual purge. Clear early with the worker user, which owns
        # the cache directory, since the container drops CAP_DAC_OVERRIDE:
        #   docker exec -u nobody <proxy> rm -rf /var/cache/nginx/tiles/*
        proxy_cache_valid  200 1d;
        proxy_cache_valid  404 1m;
        # Collapses concurrent requests for the same tile into one upstream call.
        proxy_cache_lock   on;

        proxy_intercept_errors on;
        # 404 means the point or tile falls outside the raster. It is kept
        # distinct from a service failure so the client can tell "no data here"
        # from "the request failed", and is rewritten to drop the upstream body,
        # which names the file path.
        error_page 404 = @tile_no_data;
        error_page 400 401 403 500 502 503 504 = @tile_error;

        header_filter_by_lua_block {
            sanitize_upstream_headers()

            -- A tile is fixed for its URI, so the browser reuses it without
            -- reissuing the request. Point responses stay uncached, which the
            -- keep list above already ensures by dropping upstream directives.
            if ngx.var.uri:find("^/cog/tiles/") then
                ngx.header["Cache-Control"] = "public, max-age=86400"
                ngx.header["X-Cache-Status"] = ngx.var.upstream_cache_status
            end
        }
    }

    location /colorMaps/ {
        proxy_pass         http://planetcantile:8000/colorMaps/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;

        proxy_connect_timeout    5s;
        proxy_read_timeout       10s;
        proxy_max_temp_file_size 1m;

        proxy_intercept_errors on;
        error_page 400 401 403 404 500 502 503 504 = @tile_error;

        header_filter_by_lua_block { sanitize_upstream_headers() }
    }

    location @tile_error {
        default_type application/json;
        return 502 '{"error":"tile service unavailable"}';
    }

    location @tile_no_data {
        default_type application/json;
        return 404 '{"error":"no data at this location"}';
    }

    location / {
        proxy_pass http://dev:5173;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_buffering off;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ws: http://localhost:${TERRAIN_PORT}; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none';" always;
    }

    # No-op when file is absent; populated by docker-compose.titiler-ui.yml
    include /etc/nginx/conf.d/titiler-ui*.conf;
}

server {
    listen ${TERRAIN_PORT};

    location / {
        proxy_pass http://terrain:${TERRAIN_PORT};
        proxy_set_header Host $host;
    }
}
